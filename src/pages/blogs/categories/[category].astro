---
import Layout from '../../../layouts/Layout.astro';

export async function getStaticPaths() {
    const allPosts = await Astro.glob('../../../../content/blogs/posts/**/*.md');
    const categories = [...new Set(allPosts.flatMap(p => p.frontmatter.categories || []))];
    
    return categories.map(category => ({
        params: { category },
        props: { category }
    }));
}

const { category } = Astro.props;
const allPosts = await Astro.glob('../../../../content/blogs/posts/**/*.md');
const categoryPosts = allPosts.filter(p => p.frontmatter.categories?.includes(category));
---

<Layout>
    <h1>Posts in #{category}</h1>
    {categoryPosts.map(post => (
        <a href={post.url}>{post.frontmatter.title}</a>
    ))}
</Layout>